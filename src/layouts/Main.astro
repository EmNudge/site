---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CommandPalette from "../components/CommandPalette/index.svelte";
import { getSlugs } from "../data/blogs";
import { getPublicationAtUri } from "../data/standard-site";
import { SITE } from "../data/env";

const { title } = Astro.props;

const siteBase = SITE ?? "https://emnudge.dev";
const ogImage = `${siteBase}/og/site.png`;
const canonicalUrl = `${siteBase}${Astro.url.pathname}`;
const siteDescription = "Personal website for EmNudge";

const pathname = Astro.url.pathname;
const standardSitePubKind = pathname.startsWith("/blog")
  ? "blog"
  : pathname.startsWith("/notes")
    ? "notes"
    : null;
const standardSitePubUri = standardSitePubKind
  ? getPublicationAtUri(standardSitePubKind)
  : null;

const slugs = await Astro.glob("../pages/blog/*.md*").then(getSlugs);
const postItems = slugs.map(({ title, url }) => [title, url] as const);

const noteSlugs = await Astro.glob("../pages/notes/*.md*").then(getSlugs);
const noteItems = noteSlugs.map(({ title, url }) => [title, url] as const);
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta name="description" content={siteDescription} />
    <meta name="author" content="EmNudge" />
    <meta name="keywords" content="EmNudge" />
    <meta name="color-scheme" content="dark light" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EmNudge" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:image" content={ogImage} />

    <script is:inline>
      // Re-apply an explicit theme override the user set against their system
      // preference. No stored value means we follow the system (handled in CSS).
      const theme = localStorage.getItem("theme");
      if (theme === "light" || theme === "dark") {
        document.documentElement.classList.add(theme);
      }
    </script>

    <link
      rel="alternate"
      type="application/rss+xml"
      href="/blog.xml"
      title="RSS feed for emnudge.dev"
    />
    <link rel="icon" href="/icons/icon_neon.webp" />
    <link rel="stylesheet" href="/app.css" />
    {standardSitePubUri && (
      <link rel="site.standard.publication" href={standardSitePubUri} />
    )}

    <title>{title}</title>

    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "WebSite",
      "name": "EmNudge",
      "url": "https://emnudge.dev",
      "description": "Personal website and blog of EmNudge, a software developer creating educational content about JavaScript, web development, and programming concepts.",
      "author": {
        "@type": "Person",
        "name": "EmNudge",
        "url": "https://emnudge.dev",
        "sameAs": [
          "https://github.com/EmNudge",
          "https://youtube.com/EmNudge",
          "https://bsky.app/profile/emnudge.dev"
        ]
      }
    })} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />

    <CommandPalette postItems={postItems} noteItems={noteItems} client:only="svelte" />

    <script type="module">
			import '/libraries/new-tag.js';
    </script>
  </body>
</html>

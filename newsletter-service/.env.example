# ---- Cloudflare Email Service ----
# Account ID from the Cloudflare dashboard.
CF_ACCOUNT_ID=
# API token scoped to the email-send permission for that account.
CF_EMAIL_TOKEN=
# Verified sender on your onboarded sending domain.
FROM_EMAIL=noreply@mail.emnudge.dev
# Optional sender display name.
FROM_NAME=EmNudge
# Default byline author shown in the email header (defaults to "EmNudge").
AUTHOR_NAME=EmNudge

# ---- Turnstile (bot gate on /subscribe) ----
# Required unless in dev mode (no CF creds) — the service refuses to start without it.
TURNSTILE_SECRET=

# ---- Admin auth for /admin/send (used by send-newsletter.mjs) ----
# Generate a long random string, e.g. `openssl rand -hex 32` (min 32 chars outside dev mode).
ADMIN_TOKEN=

# ---- URLs ----
# The static site origin (used for CORS + human-facing confirm/unsub links).
SITE_ORIGIN=https://emnudge.dev
# This service's own public URL (used for the one-click List-Unsubscribe header).
PUBLIC_BASE=https://newsletter.emnudge.dev

# ---- Optional tuning (defaults shown) ----
PORT=8787
# Bind address. Default 127.0.0.1: the service must only be reachable through a
# proxy on the same host (cloudflared, or Caddy). Only set 0.0.0.0 if you fully
# understand that a directly-reachable service lets clients spoof their IP and
# bypass the per-IP rate limit.
BIND_HOST=127.0.0.1
# Header carrying the real client IP, which every per-IP guard keys on:
#   cf-connecting-ip  behind Cloudflare Tunnel (recommended; see README)
#   x-forwarded-for   behind Caddy on the same host (deploy/Caddyfile) — the default
CLIENT_IP_HEADER=cf-connecting-ip
DB_PATH=./data/newsletter.db
RATE_LIMIT_PER_MIN=5
GLOBAL_CONFIRM_CAP_PER_HOUR=200
# Daily ceiling on confirmation emails, so a signup flood can't use up the
# Cloudflare sending quota that newsletter blasts need.
GLOBAL_CONFIRM_CAP_PER_DAY=500
# Past a cap, confirmations are queued and sent as slots free up. Max waiting
# (429 beyond it), and how long one may wait before it is dropped.
CONFIRM_QUEUE_MAX=1000
CONFIRM_QUEUE_MAX_AGE_HOURS=24
# Delete subscriptions still unconfirmed after this many days. 0 disables.
PENDING_EXPIRY_DAYS=7
# Reject signups whose domain can't receive mail (no MX / A record). 0 disables.
MX_CHECK=1
# Per-IP hourly cap on confirmation emails sent, so one source can't burn the
# whole global cap and lock out other signups. 0 disables.
PER_IP_CONFIRM_CAP_PER_HOUR=20
# Max request body sizes in bytes (413 beyond these). Public routes / admin blast.
MAX_BODY_BYTES=16384
MAX_SEND_BODY_BYTES=524288
# Failed admin-auth attempts per IP per 15 min before a temporary 429 block.
ADMIN_AUTH_MAX_FAILURES=10
# Min gap before re-sending a confirmation to the same address (blocks inbox-bombing). 0 disables.
CONFIRM_RESEND_COOLDOWN_MIN=15
# How often (min) to sync Cloudflare's suppression list (complaints + hard bounces). 0 = off.
SUPPRESSION_SYNC_MIN=60
SEND_THROTTLE_MS=500

# ---- Backups to Cloudflare R2 (optional) ----
# Set all four to back the database up to R2 about once a day (checked hourly;
# status and a "Back up now" button are on the dashboard). Leave all unset to turn
# automatic backups off — the dashboard's "Download backup" works either way.
# Token: an R2 API token with "Object Read & Write" on this bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Key prefix inside the bucket.
R2_PREFIX=newsletter

# ---- Observability (optional) ----
# tracing-subscriber log filter. Defaults to `info`. Examples:
#   RUST_LOG=info
#   RUST_LOG=newsletter_service=debug,tower_http=debug
RUST_LOG=info
